{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "ES2017"
    ],
    "module": "commonjs",
    "strict": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": [
      "@figma/plugin-typings"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}